#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    config_load aott_history
    config_get enabled main enabled 0
    [ "$enabled" = "1" ] || return 0

    mkdir -p /run/aott-history || return 1
    chown root:root /run/aott-history || return 1
    chmod 0700 /run/aott-history || return 1

    procd_open_instance "aott-history"
    procd_set_param command /usr/libexec/8311-history-wrapper
    procd_set_param file /etc/config/aott_history
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger aott_history
}
