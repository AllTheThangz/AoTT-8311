#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    config_load aott_history
    config_get enabled main enabled 0
    [ "$enabled" = "1" ] || return 0

    # This vendor image has /var/run (tmpfs), not /run.
    # Fail closed on an unsafe existing path. A stale/symlink path must not
    # redirect the root-owned history worker or be followed by chmod/chown.
    [ -d /var/run ] && [ ! -L /var/run ] || return 1
    if [ ! -e /var/run/aott-history ] && [ ! -L /var/run/aott-history ]; then
        (umask 077; mkdir -m 0700 /var/run/aott-history) || return 1
    fi
    [ -d /var/run/aott-history ] && [ ! -L /var/run/aott-history ] || return 1
    [ "$(stat -c '%u:%g:%a' /var/run/aott-history)" = '0:0:700' ] || return 1

    procd_open_instance "aott-history"
    procd_set_param command /usr/libexec/8311-history-wrapper
    procd_set_param file /etc/config/aott_history
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger aott_history
}
