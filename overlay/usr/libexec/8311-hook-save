#!/bin/sh
set -f
umask 077

# Keep the same stable inode as the VLAN daemon. The shipped BusyBox flock
# has no -w option, so acquire FD 7 nonblocking with a bounded retry loop.
# Never remove this lock file: replacing it would split the lock domain.
path=/tmp/8311-fix-vlans.lock
uid=$(id -u) || exit 73
safe_lock_path() {
    [ ! -L "$path" ] && [ -f "$path" ] || return 1
    [ "$(stat -c '%u' "$path")" = "$uid" ] || return 1
    [ "$(stat -c '%h' "$path")" = 1 ] || return 1
    case "$(stat -c '%a' "$path")" in *[2367][0-7]|*[0-7][2367]) return 1;; esac
}
if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    (set -C; : > "$path") 2>/dev/null || safe_lock_path || exit 73
fi
safe_lock_path || exit 73
inode=$(stat -c '%d:%i' "$path") || exit 73
exec 7>>"$path" || exit 73
safe_lock_path &&
    [ "$(stat -Lc '%d:%i' /proc/self/fd/7)" = "$inode" ] &&
    [ "$(stat -c '%d:%i' "$path")" = "$inode" ] || exit 73

elapsed=0
until flock -n 7; do
    [ "$elapsed" -lt 5 ] || exit 75
    sleep 1 || exit 75
    elapsed=$((elapsed + 1))
done

# Exec preserves FD 7, holding the lock throughout validation, replacement
# and readback. It is released automatically when the worker exits.
exec /usr/bin/lua /usr/libexec/8311-hook-save.lua "$@"
