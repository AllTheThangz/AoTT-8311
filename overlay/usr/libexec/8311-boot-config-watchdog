#!/bin/sh
# One-boot configuration trial watchdog. It never starts without a running trial.
/usr/libexec/8311-boot-config-guard status >/dev/null 2>&1
case "$?" in
    20) ;;
    0) exit 0 ;;
    *) exit 1 ;;
esac

sleep 180

/usr/libexec/8311-boot-config-guard timeout >/dev/null 2>&1
case "$?" in
    10)
        sync || exit 1
        reboot
        exit 0
        ;;
    0) exit 0 ;;
    *) exit 1 ;;
esac
