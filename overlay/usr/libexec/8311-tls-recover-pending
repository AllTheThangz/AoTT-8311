#!/usr/bin/lua
local activation=require "8311.tls_activation"
local result,why=activation.recover_pending()
if not result then
    io.stderr:write("Pending TLS recovery failed: "..tostring(why).."\n")
    os.exit(1)
end
if result.recovered then
    print("Pending TLS activation rolled back before HTTPS startup.")
end
os.exit(0)
