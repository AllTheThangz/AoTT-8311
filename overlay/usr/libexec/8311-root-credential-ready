#!/usr/bin/lua
-- Exit-status-only live root credential validator. Never prints the hash or password.
local ok,nixio=pcall(require,"nixio")
if not ok or type(nixio)~="table" or type(nixio.crypt)~="function" then os.exit(24) end
local guard=require "8311.root_credential_guard"
local entry
if type(nixio.getsp)=="function" then entry=nixio.getsp("root") end
if not entry and type(nixio.getpw)=="function" then entry=nixio.getpw("root") end
local hash=entry and (entry.pwdp or entry.passwd)
local ready,why=guard.classify(hash,nixio.crypt)
hash=nil
entry=nil
if ready then os.exit(0) end
if why=="credential_unusable" then os.exit(21) end
os.exit(24)
